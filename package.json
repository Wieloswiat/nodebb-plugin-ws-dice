{
	"name": "nodebb-plugin-ws-dice",
	"version": "4.0.0",
	"description": "A dice plugin integrated with topic events",
	"main": "library.js",
	"scripts": {
		"lint": "eslint --fix ."
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Wieloswiat/nodebb-plugin-ws-dice"
	},
	"keywords": [
		"nodebb",
		"plugin",
		"dice",
		"shell",
		"timeline"
	],
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged",
			"commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
