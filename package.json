		"compatibility": "^4.15.0"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-angular": "21.2.2",
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"eslint": "10.8.1",
		"eslint-config-nodebb": "^2.0.3",
		"husky": "9.1.7",
		"lint-staged": "17.3.0"
	},
	"dependencies": {
		"@dice-roller/rpg-dice-roller": "5.5.1",
